# Payments stay in preview until you deliberately enable Stripe on a Node host (Vercel).
# GitHub Pages static export cannot run /api/checkout — keep preview there.

# preview | stripe
SHOP_PAYMENTS_MODE=preview
NEXT_PUBLIC_SHOP_PAYMENTS_MODE=preview

# Public shop URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_SHOP_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys). Use test keys until go-live.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: map fixed Stripe Price IDs for products without colourways
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_YEAR_BOOK=price_...
